# Save as blockchain/bnb/.env  (never commit this file)

# Deployer = second SafePal wallet 0x2b3cbb05b2f6f25882e0f6a4a012204271786863
# Fund it with tBNB from a BSC testnet faucet first.
DEPLOYER_PRIVATE_KEY=0xPASTE_PRIVATE_KEY_HERE_ON_YOUR_OWN_COMPUTER
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSCSCAN_API_KEY=

# Whole tokens (contracts apply the 18 decimals themselves)
XERA_BNB_CHAIN_SUPPLY=400000000
XERA_MINING_ALLOCATION=75000000

# Testnet only: all roles on the second wallet
XERA_VAULT_MULTISIG_ADDRESS=0x2b3cbb05b2f6f25882e0f6a4a012204271786863
XERA_GOVERNANCE_MULTISIG_ADDRESS=0x2b3cbb05b2f6f25882e0f6a4a012204271786863
XERA_TIMELOCK_ADDRESS=0x2b3cbb05b2f6f25882e0f6a4a012204271786863

# PUBLIC address of the NEW claim-signer key (generate it, see steps)
XERA_CLAIM_SIGNER_ADDRESS=0xPASTE_SIGNER_PUBLIC_ADDRESS_HERE
